# Copy to .env and fill in. .env is git-ignored.
# Existing kartoza/postgis container, host port 5436 -> container 5432
PGHOST=localhost
PGPORT=5436
PGDATABASE=urban_access
PGUSER=
PGPASSWORD=

# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Which config/cities/<slug>.yaml to use by default
CITY=carson_city
